# ── Database Configuration ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:1234@localhost:5432/questionpaper
# For local development with SQLite, uncomment the following line:
# DATABASE_URL=sqlite:///./questionpaper.db

# ── Security & Authentication ──────────────────────────────────
# Generate a secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# ── File Storage ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
# MinIO configuration (optional, if using object storage)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=questionpaper

# ── Redis / Celery Task Queue ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Vector DB / Graph DB (AI features) ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qppassword

# ── LLM Providers API Keys ─────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# ── LLM Observability / Tracking ──────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
